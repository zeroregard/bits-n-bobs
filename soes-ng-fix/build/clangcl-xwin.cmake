set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_VERSION 10.0)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
set(LLVM /usr/lib/sdk/llvm20/bin)
set(X $ENV{HOME}/opt/xwin)
set(CMAKE_C_COMPILER ${LLVM}/clang-cl)
set(CMAKE_CXX_COMPILER ${LLVM}/clang-cl)
set(CMAKE_LINKER ${LLVM}/lld-link)
set(CMAKE_AR ${LLVM}/llvm-lib)
set(CMAKE_RC_COMPILER ${LLVM}/llvm-rc)
set(CMAKE_MT ${LLVM}/llvm-mt)
set(CMAKE_C_COMPILER_TARGET x86_64-pc-windows-msvc)
set(CMAKE_CXX_COMPILER_TARGET x86_64-pc-windows-msvc)
set(INC "/imsvc ${X}/crt/include /imsvc ${X}/sdk/include/ucrt /imsvc ${X}/sdk/include/um /imsvc ${X}/sdk/include/shared /imsvc ${X}/sdk/include/winrt")
set(CMAKE_C_FLAGS_INIT "${INC}")
set(CMAKE_CXX_FLAGS_INIT "${INC} -Wno-everything")
set(CMAKE_RC_FLAGS_INIT "/I ${X}/sdk/include/um /I ${X}/sdk/include/shared")
set(LIBP "/libpath:$ENV{HOME}/src/soes-deps/libcase /libpath:${X}/crt/lib/x86_64 /libpath:${X}/sdk/lib/um/x86_64 /libpath:${X}/sdk/lib/ucrt/x86_64")
set(CMAKE_EXE_LINKER_FLAGS_INIT "${LIBP}")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${LIBP}")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "${LIBP}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_FIND_ROOT_PATH $ENV{HOME}/src/soes-deps/prefix)
set(CMAKE_MSVC_RUNTIME_LIBRARY MultiThreadedDLL)
set(CMAKE_TRY_COMPILE_CONFIGURATION Release)
set(CMAKE_POLICY_DEFAULT_CMP0091 NEW)
set(CMAKE_POLICY_VERSION_MINIMUM 3.5)
